# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/joby?sslmode=require

# JWT (generate: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-min-32-chars-long-here

# OTP Provider: "mock" | "greenapi_whatsapp"
OTP_PROVIDER=mock

# Development: show OTP in API response (NEVER in production)
OTP_EXPOSE_IN_DEV=true

# Development: fall back to mock if Green-API fails
OTP_ALLOW_DEV_FALLBACK=true

# Green-API WhatsApp (required when OTP_PROVIDER=greenapi_whatsapp)
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
