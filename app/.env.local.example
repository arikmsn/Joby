# ============================================================
# Joby — Environment Variables
# ============================================================

# Neon Postgres (required)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/joby?sslmode=require

# JWT signing secret (required, generate: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-min-32-chars-long-here

# Cron route authentication (required, generate: openssl rand -base64 32)
# Vercel Cron sends this automatically via x-cron-secret header
CRON_SECRET=your-cron-secret-here

# OTP Provider: "mock" | "greenapi_whatsapp"
OTP_PROVIDER=mock

# Green-API WhatsApp (required when OTP_PROVIDER=greenapi_whatsapp)
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# ── OTP debug mode (optional, safe-by-default) ──
# Master switch for exposing OTPs via API responses. Must be "expose" to
# enable anything below. Leave unset/off in production.
OTP_DEBUG_MODE=off

# Comma-separated list of phone numbers (any format) allowed to receive
# debugOtp in the response. Required (non-empty) for OTP_DEBUG_MODE=expose
# to have any effect.
OTP_DEBUG_ALLOWLIST=

# Shared secret the caller must send as the "x-otp-debug-secret" header to
# receive debugOtp. Required for exposure — without a matching header,
# OTP is never exposed even for allowlisted phones.
OTP_DEBUG_SECRET=

# If "true", and the conditions above are met, a failed provider send still
# returns success with debugOtp (providerStatus: "send_failed_fallback_used").
# Has no effect unless OTP_DEBUG_MODE=expose + allowlist + secret all match.
OTP_ALLOW_PROVIDER_FALLBACK=false
